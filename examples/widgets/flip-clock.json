{
  "name": "Flip Clock",
  "led": {
    "color": "accent",
    "mode": "breathe",
    "speed": 5000,
    "brightness": 25
  },
  "style": {
    "direction": "column",
    "gap": 8,
    "padding": 8
  },
  "styles": {
    "tile": {
      "background": "#2a3240",
      "gradient": "#0f1319",
      "radius": 14,
      "border": "#343e4e"
    },
    "digit": {
      "font": "bold",
      "size": 104,
      "align": "center"
    }
  },
  "elements": [
    {
      "type": "box",
      "class": "tile",
      "h": 128,
      "children": [
        {
          "type": "text",
          "class": "digit",
          "x": 77,
          "y": 12,
          "text": "{time.hour}"
        },
        {
          "type": "rect",
          "x": 0,
          "y": 63,
          "w": 154,
          "h": 2,
          "color": "bg",
          "fill": true
        },
        {
          "type": "circle",
          "x": -6,
          "y": 58,
          "r": 6,
          "color": "bg"
        },
        {
          "type": "circle",
          "x": 148,
          "y": 58,
          "r": 6,
          "color": "bg"
        }
      ]
    },
    {
      "type": "box",
      "class": "tile",
      "h": 128,
      "children": [
        {
          "type": "text",
          "class": "digit",
          "x": 77,
          "y": 12,
          "text": "{time.min}",
          "color": "accent"
        },
        {
          "type": "rect",
          "x": 0,
          "y": 63,
          "w": 154,
          "h": 2,
          "color": "bg",
          "fill": true
        },
        {
          "type": "circle",
          "x": -6,
          "y": 58,
          "r": 6,
          "color": "bg"
        },
        {
          "type": "circle",
          "x": 148,
          "y": 58,
          "r": 6,
          "color": "bg"
        }
      ]
    },
    {
      "type": "text",
      "text": "{time.ampm}  {date.day} {date.md}",
      "font": "sans",
      "size": 18,
      "align": "center",
      "color": "#7c8794"
    }
  ]
}
