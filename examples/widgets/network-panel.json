{
  "name": "Network",
  "led": {
    "color": "{wifi.color}",
    "mode": "solid",
    "brightness": 40,
    "rules": [
      {
        "when": "wifi.rssi < -85",
        "color": "bad",
        "mode": "blink",
        "speed": 500
      },
      {
        "key": "ping.router.status",
        "is": "down",
        "color": "bad",
        "mode": "blink",
        "speed": 300
      }
    ]
  },
  "style": {
    "direction": "column",
    "gap": 6,
    "padding": 8
  },
  "elements": [
    {
      "type": "box",
      "style": {
        "direction": "row",
        "justify": "between"
      },
      "children": [
        {
          "type": "text",
          "text": "NETWORK",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "text": "{time}",
          "align": "right",
          "color": "#7c8794"
        }
      ]
    },
    {
      "type": "box",
      "h": 80,
      "style": {
        "padding": 8,
        "radius": 12,
        "background": "#10304c",
        "gradient": "#070b10",
        "border": "#1c3a5c"
      },
      "children": [
        {
          "type": "arc",
          "x": 0,
          "y": 0,
          "w": 64,
          "value": "{wifi.pct}",
          "start": 225,
          "end": 495,
          "color": "{wifi.color}",
          "style": {
            "thickness": 7,
            "background": "#0e2236"
          }
        },
        {
          "type": "text",
          "x": 32,
          "y": 18,
          "text": "{wifi.pct}",
          "font": "bold",
          "size": 22,
          "align": "center"
        },
        {
          "type": "text",
          "x": 32,
          "y": 42,
          "text": "%",
          "align": "center",
          "color": "#c4ccd6"
        },
        {
          "type": "text",
          "x": 72,
          "y": 6,
          "text": "{wifi.ssid}",
          "font": "bold",
          "size": 15
        },
        {
          "type": "text",
          "x": 72,
          "y": 28,
          "text": "{wifi.rssi} dBm",
          "color": "#c4ccd6"
        },
        {
          "type": "box",
          "x": 72,
          "y": 42,
          "w": 26,
          "h": 16,
          "children": [
            {
              "type": "rect",
              "x": 0,
              "y": 12,
              "w": 5,
              "h": 4,
              "color": "{if(wifi.rssi>-85,rgb(61,220,132),rgb(36,44,56))}",
              "fill": true,
              "style": {
                "radius": 1
              }
            },
            {
              "type": "rect",
              "x": 7,
              "y": 8,
              "w": 5,
              "h": 8,
              "color": "{if(wifi.rssi>-75,rgb(61,220,132),rgb(36,44,56))}",
              "fill": true,
              "style": {
                "radius": 1
              }
            },
            {
              "type": "rect",
              "x": 14,
              "y": 4,
              "w": 5,
              "h": 12,
              "color": "{if(wifi.rssi>-65,rgb(61,220,132),rgb(36,44,56))}",
              "fill": true,
              "style": {
                "radius": 1
              }
            },
            {
              "type": "rect",
              "x": 21,
              "y": 0,
              "w": 5,
              "h": 16,
              "color": "{if(wifi.rssi>-55,rgb(61,220,132),rgb(36,44,56))}",
              "fill": true,
              "style": {
                "radius": 1
              }
            }
          ]
        }
      ]
    },
    {
      "type": "box",
      "h": 26,
      "children": [
        {
          "type": "rect",
          "x": 0,
          "y": 4,
          "w": 154,
          "h": 6,
          "color": "#c0392b",
          "fill": true,
          "style": {
            "radius": 3,
            "gradient": "#2fd37a",
            "gradientDir": "right"
          }
        },
        {
          "type": "circle",
          "x": "{clamp(wifi.pct*1.44,0,144)}",
          "y": 2,
          "r": 5,
          "color": "text",
          "style": {
            "border": "bg",
            "borderWidth": 2
          }
        },
        {
          "type": "text",
          "x": 0,
          "y": 16,
          "text": "-90",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "x": 77,
          "y": 16,
          "text": "signal dBm",
          "align": "center",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "x": 154,
          "y": 16,
          "text": "-40",
          "align": "right",
          "color": "#7c8794"
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "gap": 9,
        "radius": 10,
        "background": "#141a22",
        "gradient": "#0b0e13",
        "border": "#252d38",
        "padding": 8
      },
      "children": [
        {
          "type": "box",
          "style": {
            "direction": "row",
            "justify": "between"
          },
          "children": [
            {
              "type": "text",
              "text": "IP",
              "color": "#7c8794"
            },
            {
              "type": "text",
              "text": "{wifi.ip}",
              "align": "right"
            }
          ]
        },
        {
          "type": "box",
          "style": {
            "direction": "row",
            "justify": "between"
          },
          "children": [
            {
              "type": "text",
              "text": "host",
              "color": "#7c8794"
            },
            {
              "type": "text",
              "text": "{hostname}.local",
              "align": "right"
            }
          ]
        },
        {
          "type": "box",
          "style": {
            "direction": "row",
            "justify": "between"
          },
          "children": [
            {
              "type": "text",
              "text": "uptime",
              "color": "#7c8794"
            },
            {
              "type": "text",
              "text": "{uptime}",
              "align": "right"
            }
          ]
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "gap": 6,
        "radius": 10,
        "background": "#141a22",
        "gradient": "#0b0e13",
        "border": "#252d38",
        "padding": 8
      },
      "children": [
        {
          "type": "box",
          "style": {
            "direction": "row",
            "justify": "between",
            "align": "center"
          },
          "children": [
            {
              "type": "text",
              "text": "GATEWAY",
              "color": "#7c8794"
            },
            {
              "type": "box",
              "style": {
                "direction": "row",
                "gap": 3,
                "align": "end"
              },
              "children": [
                {
                  "type": "text",
                  "text": "{ping.router.ms}",
                  "font": "bold",
                  "size": 18,
                  "color": "{ping.router.color}"
                },
                {
                  "type": "text",
                  "text": "ms",
                  "color": "#7c8794"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "text": "{ping.router.bars}",
          "size": 2,
          "align": "center",
          "color": "{ping.router.color}"
        }
      ]
    },
    {
      "type": "text",
      "x": 77,
      "y": 296,
      "text": "{date.dow} {date.md}",
      "align": "center",
      "color": "dim"
    }
  ]
}
