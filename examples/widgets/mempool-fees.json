{
  "name": "Mempool",
  "led": {
    "color": "warn",
    "mode": "breathe",
    "speed": 4000,
    "rules": [
      {
        "when": "api.fees.fast >= 50",
        "color": "bad",
        "mode": "pulse",
        "speed": 1000
      },
      {
        "when": "api.fees.fast <= 5",
        "color": "ok",
        "mode": "solid"
      }
    ]
  },
  "style": {
    "direction": "column",
    "gap": 6,
    "padding": 8,
    "justify": "center"
  },
  "elements": [
    {
      "type": "text",
      "text": "BITCOIN NETWORK",
      "color": "dim",
      "align": "center"
    },
    {
      "type": "text",
      "text": "{api.tip.height}",
      "font": "bold",
      "size": 36,
      "align": "center"
    },
    {
      "type": "text",
      "text": "block height",
      "color": "dim",
      "align": "center"
    },
    {
      "type": "line",
      "h": 1,
      "color": "dim"
    },
    {
      "type": "text",
      "text": "fees · sat/vB",
      "color": "dim"
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "next block",
          "color": "dim"
        },
        {
          "type": "text",
          "text": "{api.fees.fast}",
          "align": "right",
          "font": "bold",
          "size": 18
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      }
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "30 min",
          "color": "dim"
        },
        {
          "type": "text",
          "text": "{api.fees.half}",
          "align": "right",
          "font": "sans",
          "size": 18
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      }
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "1 hour",
          "color": "dim"
        },
        {
          "type": "text",
          "text": "{api.fees.hour}",
          "align": "right",
          "font": "sans",
          "size": 18
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      }
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "economy",
          "color": "dim"
        },
        {
          "type": "text",
          "text": "{api.fees.eco}",
          "align": "right",
          "font": "sans",
          "size": 18
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      }
    },
    {
      "type": "line",
      "h": 1,
      "color": "dim"
    },
    {
      "type": "text",
      "text": "mempool.space · {api.fees.age} ago",
      "color": "dim",
      "align": "center"
    }
  ]
}
