{
  "name": "Photo Frame",
  "led": {
    "color": "#ffffff",
    "mode": "breathe",
    "speed": 8000,
    "brightness": 15
  },
  "style": {
    "image": "https://httpbin.org/image/png",
    "direction": "column",
    "justify": "end",
    "padding": 8,
    "gap": 4
  },
  "elements": [
    {
      "type": "box",
      "style": {
        "background": "#000000",
        "gradient": "#141a22",
        "radius": 12,
        "padding": 9,
        "gap": 4,
        "border": "#2a3240"
      },
      "children": [
        {
          "type": "text",
          "text": "{time}",
          "font": "bold",
          "size": 38,
          "align": "center"
        },
        {
          "type": "text",
          "text": "{date.day} {date.md}",
          "font": "sans",
          "size": 14,
          "align": "center",
          "color": "#c4ccd6"
        },
        {
          "type": "bar",
          "h": 4,
          "value": "{(time.hour*60+time.min)/14.4}",
          "color": "#7fb4ff",
          "style": {
            "gradient": "text",
            "gradientDir": "right",
            "radius": 2,
            "background": "#2a3240"
          }
        }
      ]
    }
  ]
}
