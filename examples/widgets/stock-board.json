{
  "name": "Stocks",
  "led": {
    "color": "ok",
    "mode": "solid",
    "speed": 2000,
    "brightness": 30,
    "rules": [
      {
        "when": "max(api.nvda.dp, api.tsm.dp, api.sgdm.dp, api.vti.dp) < 0",
        "color": "bad",
        "mode": "solid"
      },
      {
        "when": "min(api.nvda.dp, api.tsm.dp, api.sgdm.dp, api.vti.dp) < 0",
        "color": "warn",
        "mode": "solid"
      }
    ]
  },
  "style": {
    "direction": "column",
    "gap": 6,
    "padding": 8,
    "justify": "center"
  },
  "elements": [
    {
      "type": "text",
      "text": "WATCHLIST",
      "color": "dim"
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "NVDA",
          "font": "bold",
          "size": 16,
          "w": 48
        },
        {
          "type": "text",
          "text": "{round(api.nvda.c, 2)}",
          "size": 15,
          "font": "bold"
        },
        {
          "type": "text",
          "text": "{round(api.nvda.dp, 1)}%",
          "align": "right",
          "size": 15,
          "font": "bold",
          "x": 146,
          "y": 16
        }
      ],
      "style": {
        "direction": "column",
        "justify": "between",
        "padding": 2,
        "gap": 0,
        "borderWidth": 0
      }
    },
    {
      "type": "bar",
      "h": 4,
      "value": "{clamp(api.nvda.dp * 10 + 50, 0, 100)}",
      "color": "ok",
      "style": {
        "background": "#202020",
        "radius": 3
      }
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "TSM",
          "font": "bold",
          "size": 16,
          "w": 48
        },
        {
          "type": "text",
          "text": "{round(api.tsm.c, 2)}",
          "size": 15,
          "font": "bold"
        },
        {
          "type": "text",
          "text": "{round(api.tsm.dp, 1)}%",
          "align": "right",
          "size": 15,
          "font": "bold",
          "x": 146,
          "y": 16
        }
      ],
      "style": {
        "direction": "column",
        "justify": "between",
        "padding": 2,
        "gap": 0,
        "borderWidth": 0
      }
    },
    {
      "type": "bar",
      "h": 4,
      "value": "{clamp(api.tsm.dp * 10 + 50, 0, 100)}",
      "color": "ok",
      "style": {
        "background": "#202020",
        "radius": 3
      }
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "SGDM",
          "font": "bold",
          "size": 16,
          "w": 48
        },
        {
          "type": "text",
          "text": "{round(api.sgdm.c, 2)}",
          "size": 15,
          "font": "bold"
        },
        {
          "type": "text",
          "text": "{round(api.sgdm.dp, 1)}%",
          "align": "right",
          "size": 15,
          "font": "bold",
          "x": 146,
          "y": 16
        }
      ],
      "style": {
        "direction": "column",
        "justify": "between",
        "padding": 2,
        "gap": 0,
        "borderWidth": 0
      }
    },
    {
      "type": "bar",
      "h": 4,
      "value": "{clamp(api.sgdm.dp * 10 + 50, 0, 100)}",
      "color": "ok",
      "style": {
        "background": "#202020",
        "radius": 3
      }
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "VTI",
          "font": "bold",
          "size": 16,
          "w": 48
        },
        {
          "type": "text",
          "text": "{round(api.vti.c, 2)}",
          "size": 15,
          "font": "bold"
        },
        {
          "type": "text",
          "text": "{round(api.vti.dp, 1)}%",
          "align": "right",
          "size": 15,
          "font": "bold",
          "x": 146,
          "y": 16
        }
      ],
      "style": {
        "direction": "column",
        "justify": "between",
        "padding": 2,
        "gap": 0,
        "borderWidth": 0
      }
    },
    {
      "type": "bar",
      "h": 4,
      "value": "{clamp(api.vti.dp * 10 + 50, 0, 100)}",
      "color": "ok",
      "style": {
        "background": "#202020",
        "radius": 3
      }
    },
    {
      "type": "line",
      "h": 1,
      "color": "dim"
    },
    {
      "type": "text",
      "text": "bars: -5% left, +5% right",
      "color": "dim",
      "align": "center"
    },
    {
      "type": "text",
      "text": "{api.nvda.age} ago · {time}",
      "color": "dim",
      "align": "center"
    }
  ]
}
