{
  "name": "Stock",
  "led": {
    "color": "ok",
    "mode": "solid",
    "speed": 2000,
    "brightness": 40,
    "rules": [
      {
        "when": "api.stock.pct >= 3",
        "color": "ok",
        "mode": "pulse",
        "speed": 800
      },
      {
        "when": "api.stock.pct <= -3",
        "color": "bad",
        "mode": "blink",
        "speed": 500
      },
      {
        "when": "api.stock.pct < 0",
        "color": "bad",
        "mode": "solid"
      }
    ]
  },
  "style": {
    "direction": "column",
    "gap": 6,
    "padding": 8,
    "justify": "center"
  },
  "elements": [
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "AAPL",
          "font": "bold",
          "size": 20
        },
        {
          "type": "text",
          "text": "NASDAQ",
          "color": "dim",
          "align": "right"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      }
    },
    {
      "type": "text",
      "text": "${round(api.stock.last, 2)}",
      "font": "bold",
      "size": 40,
      "align": "center"
    },
    {
      "type": "text",
      "text": "{round(api.stock.change, 2)}  ({round(api.stock.pct, 2)}%)",
      "font": "sans",
      "size": 18,
      "align": "center"
    },
    {
      "type": "line",
      "h": 1,
      "color": "dim"
    },
    {
      "type": "text",
      "text": "day range",
      "color": "dim"
    },
    {
      "type": "bar",
      "h": 8,
      "value": "{(api.stock.last-api.stock.lo)/(api.stock.hi-api.stock.lo)*100}",
      "color": "accent",
      "style": {
        "background": "#202020",
        "radius": 3
      }
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "{round(api.stock.lo, 2)}",
          "color": "dim"
        },
        {
          "type": "text",
          "text": "{round(api.stock.hi, 2)}",
          "color": "dim",
          "align": "right"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between"
      }
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "open",
          "color": "dim"
        },
        {
          "type": "text",
          "text": "{round(api.stock.open, 2)}",
          "align": "right"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      }
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "prev close",
          "color": "dim"
        },
        {
          "type": "text",
          "text": "{round(api.stock.prev, 2)}",
          "align": "right"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      }
    },
    {
      "type": "line",
      "h": 1,
      "color": "dim"
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "{api.stock.status}",
          "color": "{api.stock.color}"
        },
        {
          "type": "text",
          "text": "{api.stock.age} ago",
          "color": "dim",
          "align": "right"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between"
      }
    }
  ]
}
