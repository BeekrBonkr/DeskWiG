{
  "name": "Temp Today",
  "led": {
    "color": "{mix(rgb(0,120,255), rgb(255,80,0), clamp((api.weather.temp + 10) / 45, 0, 1))}",
    "mode": "breathe",
    "speed": 4000,
    "brightness": 40
  },
  "style": {
    "direction": "column",
    "gap": 6,
    "padding": 8
  },
  "styles": {
    "label": {
      "color": "dim"
    }
  },
  "elements": [
    {
      "type": "box",
      "style": {
        "background": "#101820",
        "gradient": "#1c2a3a",
        "radius": 8,
        "padding": 8,
        "gap": 2
      },
      "children": [
        {
          "type": "text",
          "class": "label",
          "text": "OUTSIDE"
        },
        {
          "type": "box",
          "style": {
            "direction": "row",
            "align": "end",
            "justify": "between"
          },
          "children": [
            {
              "type": "text",
              "text": "{round(api.weather.temp)}°",
              "font": "bold",
              "size": 44,
              "color": "{mix(rgb(80,160,255), rgb(255,120,40), clamp((api.weather.temp + 10) / 45, 0, 1))}"
            },
            {
              "type": "text",
              "text": "{round(api.weather.temp.min)}° / {round(api.weather.temp.max)}°",
              "color": "dim",
              "align": "right"
            }
          ]
        }
      ]
    },
    {
      "type": "text",
      "class": "label",
      "text": "LAST 12 HOURS"
    },
    {
      "type": "chart",
      "series": "api.weather.temp",
      "window": 43200,
      "h": 90,
      "color": "{mix(rgb(80,160,255), rgb(255,120,40), clamp((api.weather.temp.avg + 10) / 45, 0, 1))}",
      "style": {
        "kind": "line",
        "thickness": 3,
        "background": "#0c1016",
        "radius": 6
      }
    },
    {
      "type": "box",
      "h": 14,
      "children": [
        {
          "type": "circle",
          "x": "{clamp((api.weather.temp - api.weather.temp.min) / max(api.weather.temp.max - api.weather.temp.min, 1) * 146, 0, 146)}",
          "y": 3,
          "r": 4,
          "color": "accent"
        },
        {
          "type": "text",
          "x": 0,
          "y": 3,
          "text": "min",
          "color": "dim"
        },
        {
          "type": "text",
          "x": 154,
          "y": 3,
          "text": "max",
          "color": "dim",
          "align": "right"
        }
      ]
    },
    {
      "type": "text",
      "class": "label",
      "text": "HUMIDITY {api.weather.humidity}%"
    },
    {
      "type": "bar",
      "h": 8,
      "value": "{api.weather.humidity}",
      "color": "#3070c0",
      "style": {
        "gradient": "#40d0ff",
        "gradientDir": "right",
        "radius": 4
      }
    },
    {
      "type": "text",
      "text": "{api.weather.age} ago · {time}",
      "color": "dim",
      "align": "center"
    }
  ]
}
