{
  "name": "System",
  "led": {
    "color": "{wifi.color}",
    "mode": "solid",
    "brightness": 30,
    "rules": [
      {
        "when": "heap < 40",
        "color": "bad",
        "mode": "blink",
        "speed": 500
      }
    ]
  },
  "style": {
    "direction": "column",
    "gap": 6,
    "padding": 8
  },
  "styles": {
    "card": {
      "background": "#141a22",
      "gradient": "#0b0e13",
      "border": "#252d38",
      "radius": 10,
      "padding": 7,
      "gap": 5
    },
    "label": {
      "color": "#7c8794"
    }
  },
  "elements": [
    {
      "type": "box",
      "style": {
        "direction": "row",
        "justify": "between"
      },
      "children": [
        {
          "type": "text",
          "text": "DESKWIG SYSTEM",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "text": "{hostname}",
          "align": "right",
          "color": "#c4ccd6"
        }
      ]
    },
    {
      "type": "box",
      "class": "card",
      "children": [
        {
          "type": "box",
          "style": {
            "direction": "row",
            "justify": "between",
            "align": "center"
          },
          "children": [
            {
              "type": "text",
              "class": "label",
              "text": "FREE HEAP"
            },
            {
              "type": "text",
              "text": "{heap}",
              "font": "bold",
              "size": 20,
              "align": "right"
            }
          ]
        },
        {
          "type": "chart",
          "h": 44,
          "series": "heap",
          "window": 3600,
          "color": "#a78bfa",
          "style": {
            "kind": "area",
            "gradient": "#221a3d",
            "background": "#0c1016",
            "radius": 6
          }
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "direction": "row",
        "gap": 6
      },
      "children": [
        {
          "type": "box",
          "class": "card",
          "w": 74,
          "children": [
            {
              "type": "text",
              "class": "label",
              "text": "UPTIME"
            },
            {
              "type": "text",
              "text": "{uptime}",
              "font": "bold",
              "size": 18
            }
          ]
        },
        {
          "type": "box",
          "class": "card",
          "w": 74,
          "children": [
            {
              "type": "text",
              "class": "label",
              "text": "TARGETS"
            },
            {
              "type": "box",
              "style": {
                "direction": "row",
                "gap": 5,
                "align": "center"
              },
              "children": [
                {
                  "type": "circle",
                  "r": 5,
                  "color": "{ping.0.color}"
                },
                {
                  "type": "circle",
                  "r": 5,
                  "color": "{ping.1.color}"
                },
                {
                  "type": "circle",
                  "r": 5,
                  "color": "{ping.2.color}"
                },
                {
                  "type": "text",
                  "text": "{ping.count}",
                  "font": "bold",
                  "size": 18
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "box",
      "class": "card",
      "children": [
        {
          "type": "text",
          "class": "label",
          "text": "CLOCK"
        },
        {
          "type": "text",
          "text": "{time.sec}",
          "font": "bold",
          "size": 30,
          "align": "center"
        },
        {
          "type": "text",
          "text": "{date} · {date.dow}",
          "align": "center",
          "color": "#7c8794"
        }
      ]
    },
    {
      "type": "box",
      "class": "card",
      "children": [
        {
          "type": "box",
          "style": {
            "direction": "row",
            "justify": "between"
          },
          "children": [
            {
              "type": "text",
              "class": "label",
              "text": "WIFI"
            },
            {
              "type": "text",
              "text": "{wifi.ssid} {wifi.rssi} dBm",
              "align": "right",
              "color": "#c4ccd6"
            }
          ]
        },
        {
          "type": "bar",
          "h": 8,
          "value": "{wifi.pct}",
          "color": "#c0392b",
          "style": {
            "gradient": "#2fd37a",
            "gradientDir": "right",
            "radius": 4,
            "background": "#1a2029"
          }
        }
      ]
    }
  ]
}
