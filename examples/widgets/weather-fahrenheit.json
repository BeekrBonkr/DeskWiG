{
  "name": "Weather (F)",
  "led": {
    "color": "ok",
    "mode": "solid",
    "brightness": 30,
    "rules": [
      {
        "when": "api.weather.temp * 9/5 + 32 >= 90",
        "color": "bad",
        "mode": "breathe",
