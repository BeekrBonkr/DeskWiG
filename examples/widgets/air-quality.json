      "children": [
        {
          "type": "box",
          "style": {
            "direction": "row",
            "justify": "between"
          },
          "children": [
            {
              "type": "text",
              "text": "0-40",
              "color": "#7c8794"
            },
            {
              "type": "text",
              "text": "good",
              "align": "right",
              "color": "#3ddc84"
            }
          ]
        },
        {
          "type": "box",
          "style": {
            "direction": "row",
            "justify": "between"
          },
          "children": [
            {
              "type": "text",
              "text": "40-80",
              "color": "#7c8794"
            },
            {
              "type": "text",
              "text": "fair",
              "align": "right",
              "color": "#ffb020"
            }
          ]
        },
        {
          "type": "box",
          "style": {
            "direction": "row",
            "justify": "between"
          },
          "children": [
            {
              "type": "text",
              "text": "80+",
              "color": "#7c8794"
            },
            {
              "type": "text",
              "text": "poor",
              "align": "right",
              "color": "#ff5a5a"
