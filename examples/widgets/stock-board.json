{
  "name": "Stocks",
  "led": {
    "color": "ok",
    "mode": "solid",
    "speed": 2000,
    "brightness": 30,
    "rules": [
      {
        "when": "max(api.nvda.dp, api.tsm.dp, api.sgdm.dp, api.vti.dp) < 0",
        "color": "bad",
        "mode": "solid"
