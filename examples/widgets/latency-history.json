{
  "name": "Latency History",
  "led": {
    "color": "{ping.0.color}",
    "mode": "solid",
    "brightness": 30
  },
  "style": {
    "direction": "column",
    "gap": 6,
    "padding": 8
  },
  "elements": [
    {
      "type": "box",
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      },
      "children": [
        {
          "type": "text",
          "text": "{ping.0.name}",
          "font": "bold",
          "size": 18
        },
        {
          "type": "box",
          "style": {
            "direction": "row",
            "gap": 3,
            "align": "end"
          },
          "children": [
            {
              "type": "text",
              "text": "{ping.0.ms}",
              "font": "bold",
              "size": 22,
              "color": "{hsv(clamp(130-ping.0.ms*1.3,0,130),85,95)}"
            },
            {
              "type": "text",
              "text": "ms",
              "color": "#7c8794"
            }
          ]
        }
      ]
    },
    {
      "type": "chart",
      "h": 84,
      "series": "ping.0.ms",
      "window": 1800,
      "color": "{ping.0.color}",
      "style": {
        "kind": "dots",
        "thickness": 2,
        "min": 0,
        "background": "#0c1016",
        "radius": 6
      }
    },
    {
      "type": "box",
      "style": {
        "direction": "row",
        "gap": 6
      },
      "children": [
        {
          "type": "box",
          "w": 74,
          "style": {
            "gap": 3,
            "padding": 6,
            "radius": 8,
            "background": "#141a22",
            "gradient": "#0b0e13",
            "border": "#252d38"
          },
          "children": [
            {
              "type": "text",
              "text": "AVERAGE",
              "align": "center",
              "color": "#7c8794"
            },
            {
              "type": "text",
              "text": "{round(ping.0.ms.avg)}",
              "font": "bold",
              "size": 18,
              "align": "center"
            }
          ]
        },
        {
          "type": "box",
          "w": 74,
          "style": {
            "gap": 3,
            "padding": 6,
            "radius": 8,
            "background": "#141a22",
            "gradient": "#0b0e13",
            "border": "#252d38"
          },
          "children": [
            {
              "type": "text",
              "text": "WORST",
              "align": "center",
              "color": "#7c8794"
            },
            {
              "type": "text",
              "text": "{round(ping.0.ms.max)}",
              "font": "bold",
              "size": 18,
              "align": "center"
            }
          ]
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "direction": "row",
        "justify": "between"
      },
      "children": [
        {
          "type": "text",
          "text": "SIGNAL",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "text": "{wifi.rssi} dBm",
          "align": "right",
          "color": "{wifi.color}"
        }
      ]
    },
    {
      "type": "chart",
      "h": 50,
      "series": "wifi.rssi",
      "window": 1800,
      "color": "accent",
      "style": {
        "kind": "area",
        "gradient": "#10233a",
        "min": -90,
        "max": -30,
        "background": "#0c1016",
        "radius": 6
      }
    },
    {
      "type": "box",
      "h": 6,
      "children": [
        {
          "type": "rect",
          "x": 0,
          "y": 0,
          "w": 154,
          "h": 6,
          "color": "#1a2029",
          "fill": true,
          "style": {
            "radius": 3
          }
        },
        {
          "type": "rect",
          "x": 0,
          "y": 0,
          "w": "{clamp(wifi.pct*1.54,3,154)}",
          "h": 6,
          "color": "#c0392b",
          "fill": true,
          "style": {
            "radius": 3,
            "gradient": "#2fd37a",
            "gradientDir": "right"
          }
        }
      ]
    },
    {
      "type": "text",
      "x": 77,
      "y": 296,
      "text": "last 30 min · {time}",
      "align": "center",
      "color": "dim"
    }
  ]
}
