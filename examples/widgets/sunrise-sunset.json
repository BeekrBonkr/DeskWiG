{
  "name": "Sun Times",
  "led": {
    "color": "#ffb000",
    "mode": "breathe",
    "speed": 6000,
    "brightness": 30,
    "rules": [
      {
        "when": "api.sun.uv >= 8",
        "color": "bad",
        "mode": "pulse",
        "speed": 1200
      },
      {
        "when": "api.sun.uv >= 6",
        "color": "warn",
        "mode": "solid"
      }
    ]
  },
  "style": {
    "direction": "column",
    "justify": "center",
    "gap": 12,
    "padding": 10
  },
  "elements": [
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "🌅",
          "font": "emoji",
          "size": 40
        },
        {
          "type": "box",
          "children": [
            {
              "type": "text",
              "text": "SUNRISE",
              "color": "dim"
            },
            {
              "type": "text",
              "text": "{api.sun.sunrise}",
              "font": "bold",
              "size": 22
            }
          ],
          "style": {
            "direction": "column",
            "gap": 2
          }
        }
      ],
      "style": {
        "direction": "row",
        "align": "center",
        "gap": 10
      }
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "🌇",
          "font": "emoji",
          "size": 40
        },
        {
          "type": "box",
          "children": [
            {
              "type": "text",
              "text": "SUNSET",
              "color": "dim"
            },
            {
              "type": "text",
              "text": "{api.sun.sunset}",
              "font": "bold",
              "size": 22
            }
          ],
          "style": {
            "direction": "column",
            "gap": 2
          }
        }
      ],
      "style": {
        "direction": "row",
        "align": "center",
        "gap": 10
      }
    },
    {
      "type": "line",
      "h": 1,
      "color": "dim"
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "☀",
          "font": "emoji",
          "size": 28
        },
        {
          "type": "text",
          "text": "{api.sun.uv} UV index",
          "font": "sans",
          "size": 18
        }
      ],
      "style": {
        "direction": "row",
        "align": "center",
        "gap": 8
      }
    },
    {
      "type": "text",
      "text": "now {time}",
      "color": "dim",
      "align": "center"
    }
  ]
}
