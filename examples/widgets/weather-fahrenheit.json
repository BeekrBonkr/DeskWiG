{
  "name": "Weather (F)",
  "style": {
    "direction": "column",
    "gap": 8,
    "padding": 8,
    "justify": "center"
  },
  "styles": {
    "k": {
      "color": "dim",
      "font": "sans",
      "size": 14
    },
    "v": {
      "font": "bold",
      "size": 22,
      "align": "right"
    }
  },
  "elements": [
    {
      "type": "text",
      "text": "{round(api.weather.temp * 9/5 + 32)}°F",
      "font": "bold",
      "size": 64,
      "align": "center"
    },
    {
      "type": "text",
      "text": "{round(api.weather.temp, 1)}°C",
      "font": "sans",
      "size": 18,
      "align": "center",
      "color": "dim"
    },
    {
      "type": "line",
      "h": 1,
      "color": "dim"
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "feels like",
          "class": "k"
        },
        {
          "type": "text",
          "text": "{round(api.weather.feels * 9/5 + 32)}°F",
          "class": "v"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      }
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "wind",
          "class": "k"
        },
        {
          "type": "text",
          "text": "{round(api.weather.wind / 1.609)} mph",
          "class": "v"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      }
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "humidity",
          "class": "k"
        },
        {
          "type": "text",
          "text": "{api.weather.humidity}%",
          "class": "v"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      }
    },
    {
      "type": "text",
      "text": "converted on the device with {math}",
      "color": "dim",
      "align": "center"
    }
  ]
}
