{
  "name": "Binary Date Clock",
  "led": {
    "color": "accent",
    "mode": "breathe",
    "speed": 4000,
    "rules": [
      {
        "when": "time.hour >= 23 || time.hour < 7",
        "mode": "off"
      }
    ]
  },
  "style": {
    "direction": "column",
    "gap": 6,
    "padding": 8
  },
  "elements": [
    {
      "type": "text",
      "text": "{time.sec} {time.ampm}",
      "color": "#7c8794",
      "align": "center",
      "size": 2
    },
    {
      "type": "box",
      "style": {
        "gap": 4,
        "padding": 7,
        "background": "#141a22",
        "gradient": "#0b0e13",
        "border": "#252d38",
        "radius": 10
      },
      "children": [
        {
          "type": "text",
          "text": "HOURS",
          "color": "#7c8794"
        },
        {
          "type": "box",
          "style": {
            "direction": "row",
            "gap": 4
          },
          "children": [
            {
              "type": "rect",
              "w": 18,
              "h": 18,
              "color": "#1a2029",
              "style": {
                "radius": 6,
                "background": "#0c0c0d"
              }
            },
            {
              "type": "rect",
              "w": 18,
              "h": 18,
              "color": "{if(floor(time.hour/16)%2,rgb(0,158,255),rgb(12,12,12))}",
              "fill": true,
              "style": {
                "radius": 6
              }
            },
            {
              "type": "rect",
              "w": 18,
              "h": 18,
              "color": "{if(floor(time.hour/8)%2,rgb(0,158,255),rgb(12,12,12))}",
