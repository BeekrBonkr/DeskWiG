          "align": "right",
          "color": "#c4ccd6"
        }
      ]
    },
    {
      "type": "chart",
      "h": 56,
      "series": "api.fees.fast",
      "window": 14400,
      "color": "#ff9f43",
      "style": {
        "kind": "area",
        "gradient": "#3a2208",
        "background": "#0c1016",
        "radius": 6,
        "min": 0
