{
  "name": "Forecast",
  "led": {
    "color": "accent",
    "mode": "breathe",
    "speed": 4000,
    "rules": [
      {
        "when": "api.fc.rain0 >= 60",
        "color": "accent",
        "mode": "pulse",
        "speed": 1500
      },
      {
        "when": "api.fc.hi0 >= 32",
        "color": "warn",
        "mode": "solid"
      },
      {
        "when": "api.fc.lo0 <= 0",
        "color": "accent",
        "mode": "solid"
      }
    ]
  },
  "style": {
    "direction": "column",
    "gap": 6,
    "padding": 8
  },
  "elements": [
    {
      "type": "box",
      "style": {
        "direction": "row",
        "justify": "between"
      },
      "children": [
        {
          "type": "text",
          "text": "3-DAY FORECAST",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "text": "{api.fc.age}",
          "align": "right",
          "color": "{api.fc.color}"
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "gap": 6,
        "padding": 7,
        "radius": 10,
        "background": "#141a22",
        "gradient": "#0b0e13",
        "border": "#252d38"
      },
      "children": [
        {
          "type": "box",
          "style": {
            "direction": "row",
            "justify": "between",
            "align": "center"
          },
          "children": [
            {
              "type": "text",
              "text": "Today",
              "font": "bold",
              "size": 16
            },
            {
              "type": "text",
              "text": "☔ {api.fc.rain0}%",
              "align": "right",
              "color": "{mix(rgb(90,100,115),rgb(64,210,255),api.fc.rain0/100)}"
            }
          ]
        },
        {
          "type": "box",
          "style": {
            "direction": "row",
            "gap": 4,
            "align": "center"
          },
          "children": [
            {
              "type": "text",
              "w": 24,
              "text": "{api.fc.lo0}°",
              "color": "#6fb1ff"
            },
            {
              "type": "box",
              "w": 82,
              "h": 10,
              "children": [
                {
                  "type": "rect",
                  "x": 0,
                  "y": 2,
                  "w": 82,
                  "h": 6,
                  "color": "#1a2029",
                  "fill": true,
                  "style": {
                    "radius": 3
                  }
                },
                {
                  "type": "rect",
                  "x": "{(api.fc.lo0+10)*1.64}",
                  "y": 2,
                  "w": "{(api.fc.hi0-api.fc.lo0)*1.64}",
                  "h": 6,
                  "color": "#3b82f6",
                  "fill": true,
                  "style": {
                    "radius": 3,
                    "gradient": "#ff9f43",
                    "gradientDir": "right"
                  }
                }
              ]
            },
            {
              "type": "text",
              "w": 24,
              "text": "{api.fc.hi0}°",
              "align": "right",
              "color": "#ffb070"
            }
          ]
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "gap": 6,
        "padding": 7,
        "radius": 10,
        "background": "#141a22",
        "gradient": "#0b0e13",
        "border": "#252d38"
      },
      "children": [
        {
          "type": "box",
          "style": {
            "direction": "row",
            "justify": "between",
            "align": "center"
          },
          "children": [
            {
              "type": "text",
              "text": "Tomorrow",
              "font": "bold",
              "size": 16
            },
            {
              "type": "text",
              "text": "☔ {api.fc.rain1}%",
              "align": "right",
              "color": "{mix(rgb(90,100,115),rgb(64,210,255),api.fc.rain1/100)}"
            }
          ]
        },
        {
          "type": "box",
          "style": {
            "direction": "row",
            "gap": 4,
            "align": "center"
          },
          "children": [
            {
              "type": "text",
              "w": 24,
              "text": "{api.fc.lo1}°",
              "color": "#6fb1ff"
            },
            {
              "type": "box",
              "w": 82,
              "h": 10,
              "children": [
                {
                  "type": "rect",
                  "x": 0,
                  "y": 2,
                  "w": 82,
                  "h": 6,
                  "color": "#1a2029",
                  "fill": true,
                  "style": {
                    "radius": 3
                  }
                },
                {
                  "type": "rect",
                  "x": "{(api.fc.lo1+10)*1.64}",
                  "y": 2,
                  "w": "{(api.fc.hi1-api.fc.lo1)*1.64}",
                  "h": 6,
                  "color": "#3b82f6",
                  "fill": true,
                  "style": {
                    "radius": 3,
                    "gradient": "#ff9f43",
                    "gradientDir": "right"
                  }
                }
              ]
            },
            {
              "type": "text",
              "w": 24,
              "text": "{api.fc.hi1}°",
              "align": "right",
              "color": "#ffb070"
            }
          ]
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "gap": 6,
        "padding": 7,
        "radius": 10,
        "background": "#141a22",
        "gradient": "#0b0e13",
        "border": "#252d38"
      },
      "children": [
        {
          "type": "box",
          "style": {
            "direction": "row",
            "justify": "between",
            "align": "center"
          },
          "children": [
            {
              "type": "text",
              "text": "Day after",
              "font": "bold",
              "size": 16
            },
            {
              "type": "text",
              "text": "☔ {api.fc.rain2}%",
              "align": "right",
              "color": "{mix(rgb(90,100,115),rgb(64,210,255),api.fc.rain2/100)}"
            }
          ]
        },
        {
          "type": "box",
          "style": {
            "direction": "row",
            "gap": 4,
            "align": "center"
          },
          "children": [
            {
              "type": "text",
              "w": 24,
              "text": "{api.fc.lo2}°",
              "color": "#6fb1ff"
            },
            {
              "type": "box",
              "w": 82,
              "h": 10,
              "children": [
                {
                  "type": "rect",
                  "x": 0,
                  "y": 2,
                  "w": 82,
                  "h": 6,
                  "color": "#1a2029",
                  "fill": true,
                  "style": {
                    "radius": 3
                  }
                },
                {
                  "type": "rect",
                  "x": "{(api.fc.lo2+10)*1.64}",
                  "y": 2,
                  "w": "{(api.fc.hi2-api.fc.lo2)*1.64}",
                  "h": 6,
                  "color": "#3b82f6",
                  "fill": true,
                  "style": {
