{
  "name": "Mempool",
  "led": {
    "color": "warn",
    "mode": "breathe",
    "speed": 4000,
    "rules": [
      {
        "when": "api.fees.fast >= 50",
        "color": "bad",
        "mode": "pulse",
        "speed": 1000
      },
      {
        "when": "api.fees.fast <= 5",
        "color": "ok",
        "mode": "solid"
      }
    ]
  },
  "style": {
    "direction": "column",
    "gap": 6,
    "padding": 8
  },
  "elements": [
    {
      "type": "box",
      "style": {
        "direction": "row",
        "justify": "between"
      },
      "children": [
        {
          "type": "text",
          "text": "BITCOIN NETWORK",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "text": "{api.fees.age}",
          "align": "right",
          "color": "{api.fees.color}"
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "padding": 10,
        "gap": 4,
        "radius": 12,
        "background": "#b35a00",
        "gradient": "#2a1500"
      },
      "children": [
        {
          "type": "text",
          "text": "BLOCK HEIGHT",
          "align": "center",
          "color": "#ffd9a8"
        },
        {
          "type": "text",
          "text": "{api.tip.height}",
          "font": "bold",
          "size": 36,
          "align": "center"
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "direction": "row",
        "justify": "between"
      },
      "children": [
        {
          "type": "text",
          "text": "FEES",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "text": "sat/vB",
          "align": "right",
          "color": "#7c8794"
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "gap": 9,
        "padding": 7,
        "background": "#141a22",
        "gradient": "#0b0e13",
        "border": "#252d38",
        "radius": 10
      },
      "children": [
        {
          "type": "box",
          "style": {
            "direction": "row",
            "gap": 4,
            "align": "center"
          },
          "children": [
            {
              "type": "text",
