{
  "name": "Day Progress",
  "led": {
    "color": "accent",
    "mode": "breathe",
    "speed": 3000,
    "rules": [
      {
        "when": "time.min == 0",
        "color": "text",
        "mode": "pulse",
        "speed": 600
      }
    ]
  },
  "style": {
    "direction": "column",
    "gap": 6,
    "padding": 8
  },
  "elements": [
    {
      "type": "box",
      "style": {
        "direction": "row",
        "justify": "between"
      },
      "children": [
        {
          "type": "text",
          "text": "TODAY",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "text": "{date.day} {date.md}",
          "align": "right",
          "color": "#7c8794"
        }
      ]
    },
    {
      "type": "box",
      "h": 136,
      "style": {
        "padding": 8,
        "radius": 12,
        "background": "#141a22",
        "gradient": "#0b0e13",
        "border": "#252d38"
      },
      "children": [
        {
          "type": "arc",
          "x": 9,
          "y": 0,
          "w": 120,
          "value": "{(time.hour*60+time.min)/14.4}",
          "color": "{hsv(215-(time.hour*60+time.min)/12,80,100)}",
          "style": {
            "thickness": 10,
            "background": "#1a2029"
          }
        },
        {
          "type": "text",
          "x": 69,
          "y": 34,
          "text": "{time}",
          "font": "bold",
          "size": 30,
          "align": "center"
        },
        {
          "type": "text",
          "x": 69,
          "y": 70,
          "text": "{round((time.hour*60+time.min)/14.4)}% of the day",
          "align": "center",
          "color": "#c4ccd6"
        }
      ]
    },
    {
      "type": "box",
