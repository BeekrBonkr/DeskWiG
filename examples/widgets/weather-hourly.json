{
  "name": "Weather Now",
  "led": {
    "color": "accent",
    "mode": "breathe",
    "speed": 4000,
    "brightness": 40,
    "rules": [
      {
        "key": "api.wx.status",
        "is": "error",
        "color": "warn",
        "mode": "blink",
        "speed": 800
      },
      {
        "when": "api.wx.precipitation_2 >= 60",
        "color": "accent",
        "mode": "pulse",
        "speed": 1000
      },
      {
        "when": "api.wx.snowfall2 > 0",
        "color": "#40a0ff",
        "mode": "breathe",
        "speed": 2500
      },
      {
        "when": "api.wx.temperature_2m2 >= 90",
        "color": "#ff4000",
        "mode": "breathe",
        "speed": 2500
      },
      {
        "when": "api.wx.temperature_2m2 <= 32",
        "color": "#40a0ff",
        "mode": "solid"
      }
    ]
  },
  "style": {
    "direction": "column",
    "gap": 6,
    "padding": 8
  },
  "elements": [
    {
      "type": "box",
      "style": {
        "direction": "row",
        "justify": "between"
      },
      "children": [
        {
          "type": "text",
          "text": "WEATHER",
          "color": "dim"
        },
        {
          "type": "text",
          "text": "{api.wx.age}",
          "color": "{api.wx.color}",
          "align": "right"
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "direction": "column",
        "gap": 0,
        "padding": 8,
        "radius": 12,
        "background": "{hsv(clamp(220-(api.wx.temperature_2m2-30)*3.5,0,220),70,38)}",
        "gradient": "{hsv(clamp(220-(api.wx.temperature_2m2-30)*3.5,0,220),70,12)}"
      },
      "children": [
        {
          "type": "text",
          "text": "{round(api.wx.temperature_2m2)}°",
          "font": "bold",
          "size": 56,
          "align": "center"
        },
        {
          "type": "text",
          "text": "feels like {round(api.wx.apparent_tempe2)}°",
          "font": "sans",
          "size": 14,
          "align": "center",
          "color": "#d0d8e0"
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "direction": "row",
        "gap": 6,
        "justify": "center"
      },
      "children": [
        {
          "type": "box",
          "w": 34,
          "h": 34,
          "children": [
            {
              "type": "bar",
              "x": 0,
              "y": 0,
              "w": 34,
              "h": 34,
              "value": "{if(api.wx.is_day2==1&&api.wx.precipitation2==0,100,0)}",
              "color": "#1e3a5c",
              "style": {
                "background": "#181a20",
                "radius": 8,
                "gradient": "#2c6fb0"
              }
            },
            {
              "type": "text",
              "x": 6,
              "y": 6,
              "text": "☀",
              "font": "emoji",
              "size": 22
            }
          ]
        },
        {
          "type": "box",
          "w": 34,
          "h": 34,
          "children": [
            {
              "type": "bar",
              "x": 0,
              "y": 0,
              "w": 34,
              "h": 34,
              "value": "{if(api.wx.is_day2==0&&api.wx.precipitation2==0,100,0)}",
              "color": "#1e3a5c",
              "style": {
                "background": "#181a20",
                "radius": 8,
                "gradient": "#2c6fb0"
              }
            },
            {
              "type": "text",
              "x": 6,
              "y": 6,
              "text": "🌙",
              "font": "emoji",
              "size": 22
            }
          ]
        },
        {
          "type": "box",
          "w": 34,
          "h": 34,
          "children": [
            {
              "type": "bar",
              "x": 0,
              "y": 0,
              "w": 34,
              "h": 34,
              "value": "{if(api.wx.rain2+api.wx.showers2>0,100,0)}",
              "color": "#1e3a5c",
              "style": {
                "background": "#181a20",
                "radius": 8,
                "gradient": "#2c6fb0"
              }
            },
            {
              "type": "text",
              "x": 6,
              "y": 6,
              "text": "🌧",
              "font": "emoji",
              "size": 22
            }
          ]
        },
        {
          "type": "box",
          "w": 34,
          "h": 34,
          "children": [
            {
              "type": "bar",
              "x": 0,
              "y": 0,
              "w": 34,
              "h": 34,
              "value": "{if(api.wx.snowfall2>0,100,0)}",
              "color": "#1e3a5c",
              "style": {
                "background": "#181a20",
                "radius": 8,
                "gradient": "#2c6fb0"
              }
            },
            {
              "type": "text",
              "x": 6,
              "y": 6,
              "text": "❄",
              "font": "emoji",
              "size": 22
            }
          ]
        }
      ]
    },
    {
      "type": "text",
      "text": "☔ CHANCE OF RAIN",
      "color": "dim"
    },
    {
      "type": "box",
      "style": {
        "direction": "row",
        "gap": 6,
        "align": "center"
      },
      "children": [
        {
          "type": "bar",
          "h": 10,
          "value": "{api.wx.precipitation_2}",
          "color": "#204a80",
          "style": {
            "background": "#181a20",
            "radius": 4,
            "gradient": "#40c0ff",
            "gradientDir": "right"
          }
        },
        {
          "type": "text",
          "text": "{api.wx.precipitation_2}%",
          "align": "right",
          "w": 34
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "direction": "row",
        "gap": 6
      },
      "children": [
        {
          "type": "box",
          "style": {
            "direction": "column",
            "gap": 2,
            "padding": 6,
            "background": "#14181e",
            "border": "#2a3038",
            "radius": 8
          },
          "children": [
            {
              "type": "text",
              "text": "PRECIP",
              "color": "dim",
              "align": "center"
            },
            {
              "type": "text",
              "text": "{api.wx.precipitation2}\"",
              "font": "bold",
              "size": 20,
              "align": "center"
            }
          ]
        },
        {
          "type": "box",
          "style": {
            "direction": "column",
            "gap": 2,
            "padding": 6,
            "background": "#14181e",
            "border": "#2a3038",
            "radius": 8
          },
          "children": [
            {
              "type": "text",
              "text": "HUMIDITY",
              "color": "dim",
              "align": "center"
            },
            {
              "type": "text",
              "text": "{api.wx.relative_humid2}%",
              "font": "bold",
              "size": 20,
              "align": "center"
            }
          ]
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "direction": "row",
        "gap": 6
      },
      "children": [
        {
          "type": "box",
          "style": {
            "direction": "column",
            "gap": 2,
            "padding": 6,
            "background": "#14181e",
            "border": "#2a3038",
            "radius": 8
          },
          "children": [
            {
              "type": "text",
              "text": "RAIN",
              "color": "dim",
              "align": "center"
            },
            {
              "type": "text",
              "text": "{api.wx.rain2}\"",
              "font": "bold",
              "size": 20,
              "align": "center"
            }
          ]
        },
        {
          "type": "box",
          "style": {
            "direction": "column",
            "gap": 2,
            "padding": 6,
            "background": "#14181e",
            "border": "#2a3038",
            "radius": 8
          },
          "children": [
            {
              "type": "text",
              "text": "SNOW",
              "color": "dim",
              "align": "center"
            },
            {
              "type": "text",
              "text": "{api.wx.snowfall2}\"",
              "font": "bold",
              "size": 20,
              "align": "center"
            }
          ]
        }
      ]
    },
    {
      "type": "text",
      "text": "{time}  {date.day} {date.md}",
      "align": "center",
      "color": "dim"
    }
  ]
}
