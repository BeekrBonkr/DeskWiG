{
  "name": "Binary Clock",
  "led": {
    "color": "accent",
    "mode": "breathe",
    "speed": 4000,
    "rules": [
      {
        "when": "time.hour >= 23 || time.hour < 7",
        "mode": "off"
      }
    ]
  },
  "style": {
    "direction": "column",
    "gap": 6,
    "padding": 8
  },
  "elements": [
    {
      "type": "box",
      "style": {
        "direction": "row",
        "justify": "between"
      },
      "children": [
        {
          "type": "text",
          "text": "BINARY CLOCK",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "text": "{date.day} {date.md}",
          "align": "right",
          "color": "#7c8794"
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "gap": 6,
        "padding": 7,
        "background": "#141a22",
        "gradient": "#0b0e13",
        "border": "#252d38",
        "radius": 10
      },
      "children": [
        {
          "type": "text",
          "text": "HOURS",
          "color": "#7c8794"
        },
        {
          "type": "box",
          "style": {
            "direction": "row",
            "gap": 4
          },
          "children": [
            {
              "type": "rect",
              "w": 20,
              "h": 20,
              "color": "#1a2029",
              "style": {
                "radius": 6,
                "background": "#0c0c0d"
              }
            },
            {
              "type": "rect",
              "w": 20,
              "h": 20,
              "color": "{if(floor(time.hour/16)%2,rgb(0,158,255),rgb(12,12,12))}",
              "fill": true,
              "style": {
                "radius": 6
              }
            },
            {
              "type": "rect",
              "w": 20,
              "h": 20,
              "color": "{if(floor(time.hour/8)%2,rgb(0,158,255),rgb(12,12,12))}",
              "fill": true,
              "style": {
                "radius": 6
              }
            },
            {
              "type": "rect",
              "w": 20,
              "h": 20,
              "color": "{if(floor(time.hour/4)%2,rgb(0,158,255),rgb(12,12,12))}",
              "fill": true,
              "style": {
                "radius": 6
              }
            },
            {
              "type": "rect",
              "w": 20,
              "h": 20,
              "color": "{if(floor(time.hour/2)%2,rgb(0,158,255),rgb(12,12,12))}",
              "fill": true,
              "style": {
                "radius": 6
              }
            },
            {
              "type": "rect",
              "w": 20,
              "h": 20,
              "color": "{if(floor(time.hour/1)%2,rgb(0,158,255),rgb(12,12,12))}",
              "fill": true,
              "style": {
                "radius": 6
              }
            }
          ]
        },
        {
          "type": "text",
          "text": "MINUTES",
          "color": "#7c8794"
        },
        {
          "type": "box",
          "style": {
            "direction": "row",
            "gap": 4
          },
          "children": [
            {
              "type": "rect",
              "w": 20,
              "h": 20,
              "color": "{if(floor(time.min/32)%2,rgb(0,158,255),rgb(12,12,12))}",
              "fill": true,
              "style": {
                "radius": 6
              }
            },
            {
              "type": "rect",
              "w": 20,
              "h": 20,
              "color": "{if(floor(time.min/16)%2,rgb(0,158,255),rgb(12,12,12))}",
              "fill": true,
              "style": {
                "radius": 6
              }
            },
            {
              "type": "rect",
              "w": 20,
              "h": 20,
              "color": "{if(floor(time.min/8)%2,rgb(0,158,255),rgb(12,12,12))}",
              "fill": true,
              "style": {
                "radius": 6
              }
            },
            {
              "type": "rect",
              "w": 20,
              "h": 20,
              "color": "{if(floor(time.min/4)%2,rgb(0,158,255),rgb(12,12,12))}",
              "fill": true,
              "style": {
                "radius": 6
              }
            },
            {
              "type": "rect",
              "w": 20,
              "h": 20,
              "color": "{if(floor(time.min/2)%2,rgb(0,158,255),rgb(12,12,12))}",
              "fill": true,
              "style": {
                "radius": 6
              }
            },
            {
              "type": "rect",
              "w": 20,
              "h": 20,
              "color": "{if(floor(time.min/1)%2,rgb(0,158,255),rgb(12,12,12))}",
              "fill": true,
              "style": {
                "radius": 6
              }
            }
          ]
        },
        {
          "type": "text",
          "text": "SECONDS",
          "color": "#7c8794"
        },
        {
          "type": "box",
          "style": {
            "direction": "row",
            "gap": 4
          },
          "children": [
            {
              "type": "rect",
              "w": 20,
              "h": 20,
              "color": "{if(floor(time.second/32)%2,rgb(0,158,255),rgb(12,12,12))}",
              "fill": true,
              "style": {
                "radius": 6
              }
            },
            {
              "type": "rect",
              "w": 20,
              "h": 20,
              "color": "{if(floor(time.second/16)%2,rgb(0,158,255),rgb(12,12,12))}",
              "fill": true,
              "style": {
                "radius": 6
              }
            },
            {
              "type": "rect",
              "w": 20,
              "h": 20,
              "color": "{if(floor(time.second/8)%2,rgb(0,158,255),rgb(12,12,12))}",
              "fill": true,
              "style": {
                "radius": 6
              }
            },
            {
              "type": "rect",
              "w": 20,
              "h": 20,
              "color": "{if(floor(time.second/4)%2,rgb(0,158,255),rgb(12,12,12))}",
              "fill": true,
              "style": {
                "radius": 6
              }
            },
            {
              "type": "rect",
              "w": 20,
              "h": 20,
              "color": "{if(floor(time.second/2)%2,rgb(0,158,255),rgb(12,12,12))}",
              "fill": true,
              "style": {
                "radius": 6
              }
            },
            {
              "type": "rect",
              "w": 20,
              "h": 20,
              "color": "{if(floor(time.second/1)%2,rgb(0,158,255),rgb(12,12,12))}",
              "fill": true,
              "style": {
                "radius": 6
              }
            }
          ]
        },
        {
          "type": "box",
          "style": {
            "direction": "row",
            "gap": 4
          },
          "children": [
            {
              "type": "text",
              "w": 20,
              "text": "32",
              "align": "center",
              "color": "#7c8794"
            },
            {
              "type": "text",
              "w": 20,
              "text": "16",
              "align": "center",
              "color": "#7c8794"
            },
            {
              "type": "text",
              "w": 20,
              "text": "8",
              "align": "center",
              "color": "#7c8794"
            },
            {
              "type": "text",
              "w": 20,
              "text": "4",
              "align": "center",
              "color": "#7c8794"
            },
            {
              "type": "text",
              "w": 20,
              "text": "2",
              "align": "center",
              "color": "#7c8794"
            },
            {
              "type": "text",
              "w": 20,
              "text": "1",
              "align": "center",
              "color": "#7c8794"
            }
          ]
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "gap": 2,
        "background": "#141a22",
        "gradient": "#0b0e13",
        "border": "#252d38",
        "radius": 10,
        "padding": 8
      },
      "children": [
        {
          "type": "text",
          "text": "DECIMAL",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "text": "{time}",
          "font": "bold",
          "size": 48,
          "align": "center"
        },
        {
          "type": "text",
          "text": "{time.ampm}",
          "align": "center",
          "color": "#c4ccd6"
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "gap": 4,
        "background": "#141a22",
        "gradient": "#0b0e13",
        "border": "#252d38",
        "radius": 10,
        "padding": 8
      },
      "children": [
        {
          "type": "text",
          "text": "{date.dow}",
          "align": "center",
          "size": 18,
          "font": "bold"
        },
        {
          "type": "text",
          "text": "{date.md} {date.year}",
          "align": "center",
          "color": "#7c8794"
        }
      ]
    }
  ]
}
