{
  "name": "Daylight",
  "led": {
    "color": "warn",
    "mode": "breathe",
    "speed": 4000,
    "rules": [
      {
        "when": "api.sun.day == 0",
        "color": "accent",
        "mode": "breathe",
        "speed": 6000,
        "brightness": 15
      }
    ]
  },
  "style": {
    "direction": "column",
    "gap": 8,
    "padding": 8,
    "align": "center",
    "justify": "center"
  },
  "elements": [
    {
      "type": "text",
      "text": "DAYLIGHT",
      "color": "dim",
      "align": "center"
    },
    {
      "type": "box",
      "w": 150,
      "h": 84,
      "children": [
        {
          "type": "arc",
          "w": 150,
          "value": "{(api.sun.t-api.sun.r)/(api.sun.s-api.sun.r)*100}",
          "color": "warn",
          "style": {
            "thickness": 12
          },
          "start": 270,
          "end": 450,
          "x": 0,
          "y": 0
        },
        {
          "type": "text",
          "text": "☀",
          "x": 75,
          "y": 40,
          "align": "center",
          "font": "emoji",
          "size": 32
        }
      ]
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "🌅",
          "font": "emoji",
          "size": 16
        },
        {
          "type": "text",
          "text": "🌇",
          "font": "emoji",
          "size": 16,
          "align": "right"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between"
      }
    },
    {
      "type": "line",
      "h": 1,
      "color": "dim"
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "daylight",
          "color": "dim"
        },
        {
          "type": "text",
          "text": "{round((api.sun.s - api.sun.r) / 3600, 1)} h",
          "align": "right"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      }
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "to sunset",
          "color": "dim"
        },
        {
          "type": "text",
          "text": "{max(round((api.sun.s - api.sun.t) / 60), 0)} min",
          "align": "right"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      }
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "day",
          "color": "dim"
        },
        {
          "type": "text",
          "text": "{api.sun.day}",
          "align": "right"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      }
    },
    {
      "type": "text",
      "text": "Open-Meteo · {api.sun.age} ago",
      "color": "dim",
      "align": "center"
    }
  ]
}
