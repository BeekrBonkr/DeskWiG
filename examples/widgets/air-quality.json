              "style": {
                "gradient": "#ffb020",
                "gradientDir": "right",
                "radius": 3,
                "background": "#1a2029"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "text",
      "text": "µg/m³ · bars to 50 and 100",
      "align": "center",
      "color": "#7c8794"
    },
    {
      "type": "box",
      "style": {
        "gap": 7,
        "radius": 8,
        "background": "#141a22",
        "gradient": "#0b0e13",
        "border": "#252d38",
        "padding": 8
