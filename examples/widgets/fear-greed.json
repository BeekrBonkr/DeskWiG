{
  "name": "Fear & Greed",
  "led": {
    "color": "warn",
    "mode": "breathe",
    "speed": 3000,
    "rules": [
      {
        "when": "api.fng.value <= 25",
        "color": "bad",
        "mode": "breathe",
        "speed": 2000
      },
      {
        "when": "api.fng.value >= 75",
        "color": "ok",
        "mode": "pulse",
        "speed": 1500
      }
    ]
  },
  "style": {
    "direction": "column",
    "gap": 6,
    "padding": 8
  },
  "elements": [
    {
      "type": "box",
      "style": {
        "direction": "row",
        "justify": "between"
      },
      "children": [
        {
          "type": "text",
          "text": "FEAR & GREED",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "text": "{api.fng.age}",
          "align": "right",
          "color": "{api.fng.color}"
        }
      ]
    },
    {
      "type": "box",
      "w": 154,
      "h": 138,
      "children": [
        {
          "type": "arc",
          "x": 7,
          "y": 0,
          "w": 140,
          "value": 100,
          "start": 225,
          "end": 290,
          "color": "#6b1818",
          "style": {
            "thickness": 10
          }
        },
        {
          "type": "arc",
          "x": 7,
          "y": 0,
          "w": 140,
          "value": 100,
          "start": 294,
          "end": 344,
          "color": "#6b3d12",
          "style": {
            "thickness": 10
          }
        },
        {
          "type": "arc",
          "x": 7,
          "y": 0,
          "w": 140,
          "value": 100,
          "start": 348,
          "end": 372,
          "color": "#5f5a14",
          "style": {
            "thickness": 10
          }
        },
        {
          "type": "arc",
          "x": 7,
          "y": 0,
          "w": 140,
          "value": 100,
          "start": 376,
          "end": 426,
          "color": "#2f5a1a",
          "style": {
            "thickness": 10
          }
        },
        {
          "type": "arc",
          "x": 7,
          "y": 0,
          "w": 140,
          "value": 100,
          "start": 430,
          "end": 495,
          "color": "#14592e",
          "style": {
            "thickness": 10
          }
        },
        {
          "type": "arc",
          "x": 3,
          "y": -4,
          "w": 148,
          "value": 100,
          "start": "{221+api.fng.value*2.7}",
          "end": "{229+api.fng.value*2.7}",
          "color": "text",
          "style": {
            "thickness": 18
          }
        },
        {
          "type": "text",
          "x": 77,
          "y": 34,
          "text": "{api.fng.value}",
          "font": "bold",
          "size": 56,
          "align": "center",
          "color": "{hsv(api.fng.value*1.3,85,100)}"
        },
        {
          "type": "text",
          "x": 77,
          "y": 92,
          "text": "of 100",
          "align": "center",
          "color": "#c4ccd6"
        },
        {
          "type": "text",
          "x": 18,
          "y": 126,
          "text": "fear",
          "color": "#ff5a5a"
        },
        {
          "type": "text",
          "x": 136,
          "y": 126,
          "text": "greed",
          "align": "right",
          "color": "#3ddc84"
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "padding": 10,
        "gap": 4,
        "radius": 12,
        "background": "#141a22",
        "gradient": "#0b0e13",
        "border": "#252d38"
      },
      "children": [
        {
          "type": "text",
          "text": "{api.fng.label}",
          "font": "bold",
          "size": 24,
          "align": "center",
          "color": "{hsv(api.fng.value*1.3,85,100)}"
        },
        {
          "type": "text",
          "text": "market sentiment",
          "align": "center",
          "color": "#c4ccd6"
        }
      ]
    },
    {
      "type": "box",
      "h": 26,
      "children": [
        {
          "type": "rect",
          "x": 0,
          "y": 4,
          "w": 154,
          "h": 6,
          "color": "#d63a3a",
          "fill": true,
          "style": {
            "radius": 3,
            "gradient": "#2fd37a",
            "gradientDir": "right"
          }
        },
        {
          "type": "circle",
