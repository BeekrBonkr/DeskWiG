{
  "name": "Weather Now",
  "led": {
    "color": "accent",
    "mode": "breathe",
    "speed": 4000,
    "brightness": 40,
    "rules": [
      {
        "key": "api.wx.status",
        "is": "error",
        "color": "warn",
        "mode": "blink",
        "speed": 800
      },
      {
        "when": "api.wx.code >= 95",
        "color": "warn",
        "mode": "blink",
        "speed": 300
      },
      {
        "when": "api.wx.p0 >= 60 || api.wx.p1 >= 60",
        "color": "accent",
        "mode": "pulse",
        "speed": 1000
      },
      {
        "when": "api.wx.snow > 0",
        "color": "#40a0ff",
        "mode": "breathe",
        "speed": 2500
      },
      {
        "when": "api.wx.temp >= 90",
        "color": "#ff4000",
        "mode": "breathe",
        "speed": 2500
      },
      {
        "when": "api.wx.temp <= 32",
        "color": "#40a0ff",
        "mode": "solid"
      }
    ]
  },
  "style": {
    "direction": "column",
    "gap": 8,
    "padding": 8
  },
  "elements": [
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "WEATHER",
          "color": "dim"
        },
        {
          "type": "text",
          "text": "{api.wx.age}",
          "color": "{api.wx.color}",
          "align": "right"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between"
      }
    },
    {
      "type": "text",
      "text": "{api.wx.temp}°",
      "font": "bold",
      "size": 60,
      "align": "center"
    },
    {
      "type": "text",
      "text": "feels like {api.wx.feels}°",
      "font": "sans",
      "size": 14,
      "align": "center",
      "color": "dim"
    },
    {
      "type": "box",
      "children": [
        {
          "type": "box",
          "w": 24,
          "h": 24,
          "children": [
            {
              "type": "bar",
              "x": 0,
              "y": 0,
              "w": 24,
              "h": 24,
              "value": "{if(api.wx.code<=1&&api.wx.day==1,100,0)}",
              "color": "accent",
              "style": {
                "background": "#202020",
                "radius": 6
              }
            },
            {
              "type": "text",
