{
  "name": "Rain Ahead",
  "led": {
    "color": "accent",
    "mode": "breathe",
    "speed": 4000,
    "rules": [
      {
        "when": "api.rain.p0 >= 60 || api.rain.p1 >= 60",
        "color": "accent",
        "mode": "pulse",
        "speed": 1000
      },
      {
        "when": "max(api.rain.p0, api.rain.p1, api.rain.p2, api.rain.p3) < 20",
        "color": "warn",
        "mode": "solid"
      }
    ]
  },
