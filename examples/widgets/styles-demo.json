{
  "name": "Styles Demo",
  "led": {
    "color": "#7fa7c8",
    "mode": "breathe",
    "speed": 3000,
    "brightness": 35
  },
  "style": {
    "direction": "column",
    "gap": 6,
    "padding": 6
  },
  "styles": {
    "card": {
      "background": "#0f1a24",
      "gradient": "#0a1017",
      "border": "#24425a",
      "radius": 10,
      "padding": 7,
      "gap": 4
    },
    "label": {
      "color": "#7fa7c8"
    },
    "value": {
      "font": "bold",
      "size": 22,
      "align": "right"
    },
    "pill": {
      "background": "accent",
      "gradient": "#0b5ea8",
      "radius": 8,
      "padding": 4
    }
  },
  "elements": [
    {
      "type": "box",
      "class": "card",
      "children": [
        {
          "type": "text",
          "class": "label",
          "text": "CLASSES"
        },
        {
          "type": "box",
          "style": {
            "direction": "row",
            "justify": "between",
            "align": "center"
          },
          "children": [
            {
              "type": "text",
              "class": "label",
              "text": "time"
            },
            {
              "type": "text",
              "class": "value",
              "text": "{time}"
            }
          ]
        }
      ]
    },
    {
      "type": "box",
      "class": "card",
      "children": [
        {
          "type": "text",
          "class": "label",
          "text": "JUSTIFY BETWEEN"
        },
        {
          "type": "box",
          "style": {
            "direction": "row",
            "justify": "between"
          },
          "children": [
            {
              "type": "text",
              "text": "A"
            },
            {
              "type": "text",
              "text": "B"
            },
            {
              "type": "text",
              "text": "C"
            },
            {
              "type": "text",
              "text": "D"
            }
          ]
        }
      ]
    },
    {
      "type": "box",
      "class": "card",
      "children": [
        {
          "type": "text",
          "class": "label",
          "text": "JUSTIFY CENTER + GAP"
        },
        {
          "type": "box",
          "style": {
            "direction": "row",
            "justify": "center",
            "gap": 20
          },
          "children": [
            {
              "type": "text",
              "text": "x"
            },
            {
              "type": "text",
              "text": "y"
            },
            {
              "type": "text",
              "text": "z"
            }
          ]
        }
      ]
    },
    {
      "type": "box",
      "class": "card",
      "children": [
        {
          "type": "text",
          "class": "label",
          "text": "ALIGN"
        },
        {
          "type": "box",
          "style": {
            "direction": "row",
            "gap": 8,
            "align": "end"
          },
          "children": [
            {
              "type": "text",
              "text": "top",
              "color": "#7c8794"
            },
            {
              "type": "text",
              "text": "mid",
              "font": "bold",
              "size": 24
            },
            {
              "type": "text",
              "text": "end",
              "color": "#7c8794"
            }
          ]
        }
      ]
    },
    {
      "type": "box",
      "class": "card",
      "children": [
        {
          "type": "text",
          "class": "label",
          "text": "PILLS"
        },
        {
          "type": "box",
          "style": {
            "direction": "row",
            "gap": 4
          },
          "children": [
            {
              "type": "box",
              "class": "pill",
              "w": 40,
              "children": [
                {
                  "type": "text",
                  "text": "{wifi.pct}%",
                  "align": "center"
                }
              ]
            },
            {
              "type": "box",
              "class": "pill",
              "w": 40,
              "children": [
                {
                  "type": "text",
                  "text": "{heap}",
                  "align": "center"
                }
              ]
            },
            {
              "type": "box",
              "class": "pill",
              "w": 48,
              "children": [
                {
                  "type": "text",
                  "text": "{ping.count} tgt",
                  "align": "center"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "box",
      "class": "card",
      "children": [
        {
          "type": "text",
          "class": "label",
          "text": "GRADIENT"
        },
        {
          "type": "box",
          "style": {
            "direction": "row",
            "gap": 4
          },
          "children": [
            {
              "type": "rect",
              "w": 42,
              "h": 14,
              "style": {
                "radius": 4,
                "background": "#7a5cff",
                "gradient": "#22d3ee"
              }
            },
            {
              "type": "rect",
              "w": 42,
              "h": 14,
              "style": {
                "radius": 4,
                "background": "#7a5cff",
                "gradient": "#22d3ee",
                "gradientDir": "right"
              }
            },
            {
              "type": "bar",
              "w": 44,
              "h": 14,
              "value": "{wifi.pct}",
              "color": "#1d4ed8",
              "style": {
                "gradient": "#7fb4ff",
                "gradientDir": "right",
                "radius": 4,
                "background": "#1a2029"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "text",
      "class": "label",
      "text": "inline style beats class",
      "style": {
        "color": "warn",
        "align": "center"
      }
    }
  ]
}
