{
  "name": "GitHub User",
  "led": {
    "color": "accent",
    "mode": "breathe",
    "speed": 5000,
    "rules": [
      {
        "when": "api.repo.issues >= 10",
        "color": "warn",
        "mode": "solid"
      }
    ]
  },
  "style": {
    "direction": "column",
    "gap": 8,
    "padding": 8,
    "justify": "center"
  },
  "elements": [
    {
      "type": "text",
      "text": "{api.gh.name}",
      "font": "bold",
      "size": 20,
      "align": "center"
    },
    {
      "type": "text",
      "text": "@{api.gh.login}",
      "color": "dim",
      "align": "center"
    },
    {
      "type": "line",
      "h": 1,
      "color": "dim"
    },
    {
      "type": "box",
      "children": [
        {
          "type": "box",
          "children": [
            {
              "type": "text",
              "text": "{api.gh.repos}",
              "font": "bold",
              "size": 28,
              "align": "center"
            },
            {
              "type": "text",
              "text": "repos",
              "color": "dim",
              "align": "center"
            }
          ],
          "style": {
            "direction": "column",
            "gap": 2
          }
        },
        {
          "type": "box",
          "children": [
            {
              "type": "text",
              "text": "{api.gh.followers}",
              "font": "bold",
              "size": 28,
              "align": "center"
            },
            {
              "type": "text",
              "text": "followers",
              "color": "dim",
              "align": "center"
            }
          ],
          "style": {
            "direction": "column",
            "gap": 2
          }
        },
        {
          "type": "box",
          "children": [
            {
              "type": "text",
              "text": "{api.gh.following}",
              "font": "bold",
              "size": 28,
              "align": "center"
            },
            {
              "type": "text",
              "text": "following",
              "color": "dim",
              "align": "center"
            }
          ],
          "style": {
            "direction": "column",
            "gap": 2
          }
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between"
      }
    },
    {
      "type": "line",
      "h": 1,
      "color": "dim"
    },
    {
      "type": "text",
      "text": "DeskWiG",
      "color": "dim"
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "stars ⭐",
          "color": "dim"
        },
        {
          "type": "text",
          "text": "{api.repo.stars}",
          "align": "right"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      }
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "open issues",
          "color": "dim"
        },
        {
          "type": "text",
          "text": "{api.repo.issues}",
          "align": "right"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      }
    },
    {
      "type": "text",
      "text": "GitHub · {api.gh.age} ago",
      "color": "dim",
      "align": "center"
    }
  ]
}
