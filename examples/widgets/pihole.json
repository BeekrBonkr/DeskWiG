{
  "name": "Pi-hole",
  "led": {
    "color": "bad",
    "mode": "breathe",
    "speed": 4000,
    "brightness": 25,
    "rules": [
      {
        "key": "api.pihole.status",
        "is": "error",
        "color": "warn",
        "mode": "blink",
        "speed": 800
      }
    ]
  },
  "style": {
    "direction": "column",
    "gap": 8,
    "padding": 8,
    "align": "center",
    "justify": "center"
  },
  "elements": [
    {
      "type": "text",
      "text": "PI-HOLE",
      "color": "dim",
      "align": "center"
    },
    {
      "type": "box",
      "children": [
        {
          "type": "box",
          "children": [
            {
              "type": "arc",
              "w": 110,
              "value": "{api.pihole.pct}",
              "color": "bad",
              "style": {
                "thickness": 12
              },
              "x": 0,
              "y": 0
            },
            {
              "type": "text",
              "text": "{round(api.pihole.pct)}%",
              "x": 55,
              "y": 41,
              "align": "center",
              "font": "bold",
              "size": 24
            }
          ],
          "w": 110,
          "h": 110
        },
        {
          "type": "text",
          "text": "of queries blocked",
          "color": "dim",
          "align": "center"
        }
      ],
      "style": {
        "direction": "column",
        "gap": 4,
        "align": "center"
      }
    },
    {
      "type": "line",
      "h": 1,
      "color": "dim"
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "queries today",
          "color": "dim"
        },
        {
          "type": "text",
          "text": "{api.pihole.queries}",
          "align": "right"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      }
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "blocked today",
          "color": "dim"
        },
        {
          "type": "text",
          "text": "{api.pihole.blocked}",
          "align": "right"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      }
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "on blocklist",
          "color": "dim"
        },
        {
          "type": "text",
          "text": "{api.pihole.domains}",
          "align": "right"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      }
    },
    {
      "type": "line",
      "h": 1,
      "color": "dim"
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "{api.pihole.status}",
          "color": "{api.pihole.color}"
        },
        {
          "type": "text",
          "text": "{api.pihole.age} ago",
          "color": "dim",
          "align": "right"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between"
      }
    }
  ]
}
