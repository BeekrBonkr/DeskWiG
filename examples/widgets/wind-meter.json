{
  "name": "Wind",
  "led": {
    "color": "ok",
    "mode": "solid",
    "speed": 2000,
    "brightness": 30,
    "rules": [
      {
        "when": "api.wind.gust >= 75",
        "color": "bad",
        "mode": "blink",
        "speed": 400
      },
      {
        "when": "api.wind.speed >= 40",
        "color": "warn",
        "mode": "pulse",
        "speed": 1000
      }
    ]
  },
  "style": {
    "direction": "column",
    "gap": 8,
    "padding": 8,
    "align": "center",
    "justify": "center"
  },
  "elements": [
    {
      "type": "text",
      "text": "WIND",
      "color": "dim",
      "align": "center"
    },
    {
      "type": "box",
      "children": [
        {
          "type": "box",
          "children": [
            {
              "type": "arc",
              "w": 120,
              "value": "{min(api.wind.speed, 100)}",
              "color": "ok",
              "style": {
                "thickness": 12
              },
              "start": 225,
              "end": 495,
              "x": 0,
              "y": 0
            },
            {
              "type": "text",
              "text": "{round(api.wind.speed)}",
              "x": 60,
              "y": 42,
              "align": "center",
              "font": "bold",
              "size": 32
            }
          ],
          "w": 120,
          "h": 120
        },
        {
          "type": "text",
          "text": "km/h",
          "color": "dim",
          "align": "center"
        }
      ],
      "style": {
        "direction": "column",
        "gap": 4,
        "align": "center"
      }
    },
    {
      "type": "line",
      "h": 1,
      "color": "dim"
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "gusts",
          "color": "dim"
        },
        {
          "type": "text",
          "text": "{round(api.wind.gust)} km/h",
          "align": "right"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      }
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "direction",
          "color": "dim"
        },
        {
          "type": "text",
          "text": "{round(api.wind.dir)}°",
          "align": "right"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      }
    },
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "Beaufort",
          "color": "dim"
        },
        {
          "type": "text",
          "text": "{round((api.wind.speed / 3.01) ^ (2 / 3))}",
          "align": "right"
        }
      ],
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center"
      }
    },
    {
      "type": "text",
      "text": "Open-Meteo · {api.wind.age} ago",
      "color": "dim",
      "align": "center"
    }
  ]
}
