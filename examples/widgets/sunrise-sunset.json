{
  "name": "Sun Times",
  "led": {
    "color": "#ffb000",
    "mode": "breathe",
    "speed": 6000,
    "brightness": 30,
    "rules": [
      {
        "when": "api.sun.uv >= 8",
        "color": "bad",
        "mode": "pulse",
        "speed": 1200
      },
      {
        "when": "api.sun.uv >= 6",
        "color": "warn",
        "mode": "solid"
      }
    ]
  },
  "style": {
    "direction": "column",
    "gap": 6,
    "padding": 8
  },
  "elements": [
    {
      "type": "box",
      "style": {
        "direction": "row",
        "justify": "between"
      },
      "children": [
        {
          "type": "text",
          "text": "SUN TIMES",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "text": "{api.sun.age}",
          "align": "right",
          "color": "{api.sun.color}"
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "direction": "row",
        "gap": 10,
        "align": "center",
        "padding": 10,
        "radius": 12,
        "background": "#b3541e",
        "gradient": "#2a1206"
      },
      "children": [
        {
          "type": "text",
          "text": "🌅",
          "font": "emoji",
          "size": 34
        },
        {
          "type": "box",
          "style": {
            "gap": 6
          },
          "children": [
            {
              "type": "text",
              "text": "SUNRISE",
              "color": "#f0e6d8"
            },
            {
              "type": "box",
              "w": 90,
              "h": 24,
              "children": [
                {
                  "type": "text",
                  "x": -198,
                  "y": 0,
                  "text": "{api.sun.sunrise}",
                  "size": 3
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "direction": "row",
        "gap": 10,
        "align": "center",
        "padding": 10,
        "radius": 12,
        "background": "#5b2a86",
        "gradient": "#140a22"
      },
      "children": [
        {
          "type": "text",
          "text": "🌇",
          "font": "emoji",
          "size": 34
        },
        {
          "type": "box",
          "style": {
            "gap": 6
          },
          "children": [
            {
              "type": "text",
              "text": "SUNSET",
              "color": "#f0e6d8"
            },
            {
              "type": "box",
              "w": 90,
              "h": 24,
              "children": [
                {
                  "type": "text",
                  "x": -198,
                  "y": 0,
                  "text": "{api.sun.sunset}",
                  "size": 3
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "gap": 6,
        "background": "#141a22",
        "gradient": "#0b0e13",
        "border": "#252d38",
        "radius": 10,
        "padding": 8
      },
      "children": [
        {
          "type": "box",
          "style": {
            "direction": "row",
            "justify": "between",
            "align": "center"
          },
          "children": [
            {
              "type": "text",
              "text": "UV INDEX",
              "color": "#7c8794"
            },
            {
              "type": "text",
              "text": "{api.sun.uv}",
              "font": "bold",
              "size": 22,
              "align": "right",
              "color": "{hsv(clamp(120-api.sun.uv*12,0,120),85,100)}"
            }
          ]
        },
        {
          "type": "bar",
          "h": 10,
          "value": "{min(api.sun.uv*9,100)}",
          "color": "#2f9e44",
          "style": {
            "gradient": "#ff3b30",
            "gradientDir": "right",
            "radius": 5,
            "background": "#1a2029"
          }
        },
        {
          "type": "box",
          "style": {
            "direction": "row",
            "justify": "between"
          },
          "children": [
            {
              "type": "text",
              "text": "low",
              "color": "#7c8794"
            },
            {
              "type": "text",
              "text": "extreme",
              "align": "right",
              "color": "#7c8794"
            }
          ]
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "gap": 0,
        "radius": 10,
        "background": "#141a22",
        "gradient": "#0b0e13",
        "border": "#252d38",
        "padding": 8
      },
      "children": [
        {
          "type": "text",
          "text": "NOW",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "text": "{time}",
          "font": "bold",
          "size": 34,
          "align": "center"
        }
      ]
    },
    {
      "type": "text",
      "x": 77,
      "y": 296,
      "text": "{date.dow} {date.md}",
      "align": "center",
      "color": "dim"
    }
  ]
}
