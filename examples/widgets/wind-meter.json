{
  "name": "Wind",
  "led": {
    "color": "ok",
    "mode": "solid",
    "speed": 2000,
    "brightness": 30,
    "rules": [
      {
        "when": "api.wind.gust >= 75",
        "color": "bad",
        "mode": "blink",
        "speed": 400
      },
      {
        "when": "api.wind.speed >= 40",
        "color": "warn",
        "mode": "pulse",
        "speed": 1000
      }
    ]
  },
  "style": {
    "direction": "column",
    "gap": 6,
    "padding": 8
  },
  "elements": [
    {
      "type": "box",
      "style": {
        "direction": "row",
        "justify": "between"
      },
      "children": [
        {
          "type": "text",
          "text": "WIND",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "text": "{api.wind.age}",
          "align": "right",
          "color": "{api.wind.color}"
        }
      ]
    },
    {
      "type": "box",
      "w": 154,
      "h": 140,
      "children": [
        {
          "type": "arc",
          "x": 7,
          "y": 0,
          "w": 140,
          "value": 0,
          "style": {
            "thickness": 3,
            "background": "#25303d"
          }
        },
        {
          "type": "arc",
          "x": 3,
          "y": -4,
          "w": 148,
          "value": 100,
          "start": "{api.wind.dir-8}",
          "end": "{api.wind.dir+8}",
          "color": "text",
          "style": {
            "thickness": 11
          }
        },
        {
          "type": "arc",
          "x": 23,
          "y": 16,
          "w": 108,
          "value": "{min(api.wind.speed,100)}",
          "start": 225,
          "end": 495,
          "color": "{hsv(clamp(130-api.wind.speed*1.6,0,130),85,100)}",
          "style": {
            "thickness": 8,
            "background": "#1a2029"
          }
        },
        {
          "type": "text",
          "x": 77,
          "y": 6,
          "text": "N",
          "align": "center",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "x": 77,
          "y": 126,
          "text": "S",
          "align": "center",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "x": 14,
          "y": 66,
          "text": "W",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "x": 140,
          "y": 66,
          "text": "E",
          "align": "right",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "x": 77,
          "y": 44,
          "text": "{round(api.wind.speed)}",
          "font": "bold",
          "size": 40,
          "align": "center"
        },
        {
          "type": "text",
          "x": 77,
          "y": 86,
          "text": "km/h",
          "align": "center",
          "color": "#c4ccd6"
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "direction": "row",
        "gap": 6
