{
  "name": "World Clock",
  "led": {
    "color": "#ffffff",
    "mode": "solid",
    "brightness": 15,
    "rules": [
      {
        "when": "time.hour >= 22 || time.hour < 7",
        "mode": "off"
      }
    ]
  },
  "style": {
    "direction": "column",
    "gap": 6,
    "padding": 8
  },
  "elements": [
    {
      "type": "box",
      "style": {
        "direction": "row",
        "justify": "between"
      },
      "children": [
        {
          "type": "text",
          "text": "WORLD CLOCK",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "text": "{date.day} {date.md}",
          "align": "right",
          "color": "#7c8794"
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "padding": 8,
        "gap": 2,
        "radius": 12,
        "background": "{hsv(215,70,8+26*clamp(1-abs(time.hour-13)/7,0,1))}",
        "gradient": "#05070a",
        "border": "#1c2535"
      },
      "children": [
        {
          "type": "text",
          "text": "{time}",
          "font": "bold",
          "size": 48,
          "align": "center"
        },
        {
          "type": "text",
          "text": "local",
          "align": "center",
          "color": "#c4ccd6"
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center",
        "padding": 8,
        "radius": 10,
        "border": "#252d38",
        "background": "{hsv(220,60,max(34-3*abs((time.hour+5)%24-13),8))}",
        "gradient": "#07090d"
      },
      "children": [
        {
          "type": "box",
          "style": {
            "direction": "row",
            "gap": 8,
            "align": "center"
          },
          "children": [
            {
              "type": "circle",
              "r": 5,
              "color": "{hsv(225-185*(abs((time.hour+5)%24-13)<6),70,100)}"
            },
            {
              "type": "text",
              "text": "London",
              "font": "sans",
              "size": 16,
              "color": "#c4ccd6"
            }
          ]
        },
        {
          "type": "text",
          "text": "{(time.hour+5)%24}:{time.min}",
          "font": "bold",
          "size": 24,
          "align": "right"
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center",
        "padding": 8,
        "radius": 10,
        "border": "#252d38",
        "background": "{hsv(220,60,max(34-3*abs((time.hour+6)%24-13),8))}",
        "gradient": "#07090d"
      },
      "children": [
        {
          "type": "box",
          "style": {
            "direction": "row",
            "gap": 8,
            "align": "center"
          },
          "children": [
            {
              "type": "circle",
              "r": 5,
              "color": "{hsv(225-185*(abs((time.hour+6)%24-13)<6),70,100)}"
            },
            {
              "type": "text",
              "text": "Berlin",
              "font": "sans",
              "size": 16,
              "color": "#c4ccd6"
            }
          ]
        },
        {
          "type": "text",
          "text": "{(time.hour+6)%24}:{time.min}",
          "font": "bold",
          "size": 24,
          "align": "right"
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center",
        "padding": 8,
        "radius": 10,
        "border": "#252d38",
        "background": "{hsv(220,60,max(34-3*abs((time.hour+13)%24-13),8))}",
        "gradient": "#07090d"
      },
      "children": [
        {
          "type": "box",
          "style": {
            "direction": "row",
            "gap": 8,
            "align": "center"
          },
          "children": [
            {
              "type": "circle",
              "r": 5,
              "color": "{hsv(225-185*(abs((time.hour+13)%24-13)<6),70,100)}"
            },
            {
              "type": "text",
              "text": "Tokyo",
              "font": "sans",
              "size": 16,
              "color": "#c4ccd6"
            }
          ]
        },
        {
          "type": "text",
          "text": "{(time.hour+13)%24}:{time.min}",
          "font": "bold",
          "size": 24,
          "align": "right"
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "direction": "row",
        "justify": "between",
        "align": "center",
        "padding": 8,
        "radius": 10,
        "border": "#252d38",
        "background": "{hsv(220,60,max(34-3*abs((time.hour+14)%24-13),8))}",
        "gradient": "#07090d"
      },
      "children": [
        {
          "type": "box",
          "style": {
            "direction": "row",
            "gap": 8,
            "align": "center"
          },
          "children": [
            {
              "type": "circle",
              "r": 5,
              "color": "{hsv(225-185*(abs((time.hour+14)%24-13)<6),70,100)}"
            },
            {
              "type": "text",
              "text": "Sydney",
              "font": "sans",
              "size": 16,
              "color": "#c4ccd6"
            }
          ]
        },
        {
          "type": "text",
          "text": "{(time.hour+14)%24}:{time.min}",
          "font": "bold",
          "size": 24,
          "align": "right"
        }
      ]
    }
  ]
}
