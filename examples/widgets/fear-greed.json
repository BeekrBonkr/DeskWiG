          "y": 2,
          "r": 5,
          "color": "text",
          "style": {
            "border": "bg",
            "borderWidth": 2
          }
        },
        {
          "type": "text",
          "x": 0,
          "y": 16,
          "text": "0",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "x": 77,
          "y": 16,
          "text": "50",
          "align": "center",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "x": 154,
          "y": 16,
          "text": "100",
          "align": "right",
          "color": "#7c8794"
        }
      ]
    },
    {
      "type": "text",
      "x": 77,
      "y": 296,
      "text": "{time}  {date.day} {date.md}",
      "align": "center",
      "color": "dim"
    }
  ]
