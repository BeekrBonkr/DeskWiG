                    "gradient": "#ff9f43",
                    "gradientDir": "right"
                  }
                }
              ]
            },
            {
              "type": "text",
              "w": 24,
              "text": "{api.fc.hi2}°",
              "align": "right",
              "color": "#ffb070"
            }
          ]
        }
      ]
    },
    {
      "type": "box",
      "style": {
        "direction": "row",
        "gap": 8,
        "align": "center",
        "justify": "center",
        "padding": 8,
        "radius": 10,
        "background": "{hsv(clamp(220-(api.weather.temp+10)*5,0,220),70,34)}",
        "gradient": "{hsv(clamp(220-(api.weather.temp+10)*5,0,220),70,10)}"
      },
      "children": [
        {
          "type": "text",
          "text": "NOW",
          "color": "#7c8794"
        },
        {
          "type": "text",
          "text": "{api.weather.temp}°",
          "font": "bold",
          "size": 22
        },
        {
          "type": "text",
          "text": "feels {api.weather.feels}°",
          "color": "#c4ccd6"
        }
      ]
    },
    {
      "type": "text",
      "x": 77,
      "y": 296,
      "text": "bars span -10 to 40°",
      "align": "center",
      "color": "dim"
    }
  ]
}
