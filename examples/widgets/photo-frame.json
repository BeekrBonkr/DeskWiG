{
  "name": "Photo Frame",
  "led": {
    "color": "#ffffff",
    "mode": "breathe",
    "speed": 8000,
    "brightness": 15
  },
  "style": {
    "image": "https://httpbin.org/image/png",
    "direction": "column",
    "justify": "end",
    "padding": 8
  },
  "elements": [
    {
      "type": "box",
      "children": [
        {
          "type": "text",
          "text": "{time}",
          "font": "bold",
          "size": 36,
          "align": "center"
        },
        {
          "type": "text",
          "text": "{date.day} {date.md}",
          "font": "sans",
          "size": 14,
          "align": "center",
          "color": "dim"
        }
      ],
      "style": {
        "background": "#000000",
        "radius": 10,
        "padding": 8,
        "gap": 2
      }
    },
    {
      "type": "text",
      "text": "replace the URL with your own image",
      "color": "dim",
      "align": "center"
    }
  ]
}
